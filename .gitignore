# editor
.vscode/
.idea/

# Python
__pycache__/
*.egg-info/

# build outputs
build/
dist/
# OpenFold's CUDA extension, built in place by the editable install.
*.so

# files from script downloads
backends/openfold/openfold/resources/
backends/openfold/tests/test_data/
cutlass/
*.txt
*.pdb
*.pkl
*.fasta
*.sto
*.a3m
*.hhr

# local env files
.env
.env.*
!.env.example

# Prisma / SQLite local databases
*.db
*.db-journal
*.db-wal
*.db-shm

# dependencies -- installed into the staged workbench at serve time, never committed.
node_modules/
.pnp
.pnp.*
.bun-cache/
# `bun.lock` is the exception below: it is checked in, so an install resolves the same tree twice.

# logs
bun-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Windows / WSL downloaded-file metadata
*:Zone.Identifier

# ----------------------------------------------------
# Rust
# ----------------------------------------------------

# Rust API build artifacts
cli/target/
openfold-demo-output/

# TypeScript incremental build info
*.tsbuildinfo

# Windows executable artifacts
*.exe
*.pdb

# Session worktrees, never part of a release.
.claude/worktrees/
